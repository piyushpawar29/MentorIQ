# ── Backend ──────────────────────────────────────────────────────────────────
# These are set directly in docker-compose.yml for the backend service.
# Copy to backend/.env for local development without Docker.

PORT=5001
MONGO_URI=mongodb://localhost:27017/ConnectEd
JWT_SECRET=connectEd_secret_key_2023
JWT_COOKIE_EXPIRE=30
NODE_ENV=development

# Optional – Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional – Email
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password

# ── Frontend ─────────────────────────────────────────────────────────────────
# Copy to Frontend/.env.local for local development without Docker.
# NEXT_PUBLIC_* vars are baked into the JS bundle at build time.

NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# Server-side only (used by Next.js API routes, not exposed to the browser)
BACKEND_URL=http://localhost:5001
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=connected_nextauth_secret_2024
