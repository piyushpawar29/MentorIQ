# Backend environment variables
# MONGO_URI and PORT are overridden by docker-compose; keep these as local-dev fallbacks.
PORT=5001
MONGO_URI=mongodb://localhost:27017/ConnectEd
JWT_SECRET=connectEd_secret_key_2023
JWT_COOKIE_EXPIRE=30
NODE_ENV=development

# Cloudinary (optional – fill in if you use image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (optional – fill in if you use email features)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
